# Copie para .env (local) ou cadastre no Easypanel > App > Environment.
# NUNCA faça commit do .env com valores reais.

NODE_ENV=production
PORT=3000
# simulado (sem Hinova) | homologacao (Hinova real, WhatsApp só p/ números de teste) | producao
MODO=homologacao

# Origens que podem chamar a API (separadas por vírgula, sem barra no final)
ALLOWED_ORIGINS=https://acdmeta-del.github.io

# Cloudflare Turnstile (painel Cloudflare > Turnstile). Chave de teste que sempre passa:
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=
# Opcional: hostnames aceitos no token (ex.: acdmeta-del.github.io)
TURNSTILE_HOSTNAMES=acdmeta-del.github.io

# SGA Hinova (dados fornecidos pela Hinova / sistema do cliente)
HINOVA_BASE_URL=https://api.hinova.com.br/api/sga/v2
# Documentação: docs/api/hinova-sga-api-v2.md (seções 0 e 1). Use UMA das opções:
#  a) HINOVA_TOKEN_SGA (Área Cliente > APIs > Gerenciar APIs, liberando os endpoints usados)
#     + HINOVA_USUARIO e HINOVA_SENHA: o servidor obtém o token_usuario em /usuario/autenticar
#  b) HINOVA_TOKEN_USUARIO: um token_usuario já obtido (não expira)
# HINOVA_TOKEN (nome antigo) continua aceito. O token é escolhido PELO MODO (HINOVA_AUTH):
#   token   → HINOVA_TOKEN_USUARIO, senão HINOVA_TOKEN (HINOVA_TOKEN_SGA é ignorado: daria 401)
#   usuario → HINOVA_TOKEN_SGA, senão HINOVA_TOKEN
# "npm run testar-hinova -- CPF" mostra qual variável está em uso.
HINOVA_TOKEN_SGA=
HINOVA_TOKEN_USUARIO=
# usuario = fluxo da documentação oficial: token de acesso + login/senha de um usuário do SGA
#           em /usuario/autenticar, que devolve o token_usuario usado nas consultas (recomendado)
# token   = usa HINOVA_TOKEN direto nas consultas: só funciona se ele já for um token_usuario
#           (o que /usuario/autenticar devolve; segundo a documentação, ele não expira)
HINOVA_AUTH=usuario
# Login e senha de um usuário do SGA (de preferência um usuário só para a integração):
HINOVA_USUARIO=
HINOVA_SENHA=
# CONFIRMAR na documentação do SGA v2. Marcadores: {placa} {cpf} {codigo_veiculo} {codigo_associado}
HINOVA_PATH_AUTENTICAR=/usuario/autenticar
HINOVA_PATH_VEICULO=/veiculo/buscar/{placa}
# Boletos (igual ao n8n): POST com { placa, data_vencimento_inicial, data_vencimento_final, link_boleto: true }
# Sem placa no pedido (busca só por CPF), vai { cpf_associado, ... } no lugar de placa
HINOVA_PATH_BOLETOS=/listar/boleto-associado-veiculo
# Período de busca: soma de antes + depois de no máximo 90 dias (limite da API)
HINOVA_METODO_BOLETOS=POST
HINOVA_BOLETO_DIAS_ANTES=60
HINOVA_BOLETO_DIAS_DEPOIS=30
HINOVA_PATH_BOLETO_DETALHE=/buscar/boleto/{nosso_numero}
# Busca só por CPF: no máximo N boletos em aberto enviados por pedido
HINOVA_MAX_BOLETOS_CPF=4
# Formato do CPF na busca só por CPF: digitos (52998224725) ou mascara (529.982.247-25)
HINOVA_FORMATO_CPF=digitos
# Opcional, se o veículo não trouxer CPF/telefone do titular:
HINOVA_PATH_ASSOCIADO=
# Nomes EXATOS dos campos (só estes são lidos; sem busca por nomes parecidos).
# Padrões conferidos com respostas reais de /listar/boleto-associado-veiculo:
# HINOVA_CAMPO_CPF=cpf_associado,cpf
# HINOVA_CAMPO_PIX=pix.copia_cola
# HINOVA_CAMPO_SITUACAO=descricao_situacao_boleto,situacao_boleto
# HINOVA_SITUACOES_ABERTAS=ABERTO,EM ABERTO
# HINOVA_CAMPO_DATA_PAGAMENTO=data_pagamento
# HINOVA_CAMPO_VENCIMENTO=data_vencimento
# Telefone: "celular" da lista; no /veiculo/buscar vem separado (use "a+b" para juntar):
# HINOVA_CAMPO_TELEFONE=celular,ddd_celular+telefone_celular,telefone_celular
# "npm run testar-hinova" sugere o nome do campo quando algo sai como NÃO ENCONTRADO.

# WhatsApp: zapi (usado pelo cliente) | evolution | log (não envia, só registra)
WHATSAPP_PROVIDER=zapi
# Em MODO=homologacao, só estes números recebem (DDD + número, separados por vírgula)
WHATSAPP_TESTE_PERMITIDOS=
# Evolution API v2
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=
# Z-API (painel da Z-API):
#   ZAPI_INSTANCE     = ID da instância (Instâncias > sua instância)
#   ZAPI_TOKEN        = Token da instância (mesma tela)
#   ZAPI_CLIENT_TOKEN = Token de segurança da conta (Segurança > Token de segurança da conta)
# Teste o envio no console do App: npm run testar-whatsapp -- 11987654321
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
NOME_EMPRESA=Integra Proteção Veicular

# Limites (opcionais)
# LIMITE_POR_IP=5
# LIMITE_JANELA_MIN=15
# LIMITE_GLOBAL_HORA=300
# LIMITE_CPF_DIA=3
# RESPOSTA_MIN_MS=1000
# TRUST_PROXY=1
